rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global reusable helper
    function isSignedIn() {
      return request.auth != null;
    }

    // Blogs Collection Match
    match /blogs/{blogId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Orders Collection MATCH
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Site Images Collection MATCH
    match /site_images/{imageId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Homepage Slides Collection MATCH
    match /homepage_slides/{slideId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Premium Games Collection MATCH
    match /premium_games/{gameId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Inventory Waitlist Collection MATCH
    match /inventory_waitlist/{waitlistId} {
      allow read, write: if true;
    }

    // Metadata Collection MATCH
    match /metadata/{metaId} {
      allow read, write: if true;
    }

    // Users & KYC Profiles Collection MATCH
    match /users/{userId} {
      allow read, write: if true;
    }

    // Inventory Vault MATCH
    match /inventory_vault/{vaultId} {
      allow read, write: if true;
      match /units/{unitId} {
        allow read, write: if true;
      }
      match /ledgers/{ledgerId} {
        allow read, write: if true;
      }
    }

    // Gear Catalog MATCH
    match /gear_catalog/{catalogId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Addon Media MATCH
    match /addon_media/{mediaId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
  }
}
